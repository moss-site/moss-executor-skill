# Hyperliquid Agent Executor config template
# Usually the operator only edits these fields:
#   NETWORK, AGENT_ADDRESS, EXECUTOR_ADDRESS, EXECUTOR_PRIVATE_KEY
# SIGNER_MODE has two modes: dry_run never broadcasts; private_key broadcasts only when EXECUTOR_PRIVATE_KEY is set and --send is used.

NETWORK=testnet
AGENT_ADDRESS=0xAgentProxy
EXECUTOR_ADDRESS=0xExecutor
SIGNER_MODE=private_key
# Local only. Do not commit or print real keys.
EXECUTOR_PRIVATE_KEY=

# Network defaults. Change only when NETWORK/mainnet or custom RPC is required.
CHAIN_ID=998
EVM_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
HYPERCORE_API_URL=https://api.hyperliquid-testnet.xyz
# Perp accounts included in NAV and reconciliation. main is required.
NAV_PERP_DEXS=main,xyz

# Resolved from AGENT_ADDRESS during agent-init. Leave empty unless overriding for debugging.
ACCEPT_TOKEN=
CORE_DEPOSIT_WALLET=
USDC_TOKEN_INDEX=
USDC_SPOT_DESTINATION_DEX=
USDC_PERP_DESTINATION_DEX=0
CORE_USDC_WEI_PER_ASSET_UNIT=

# Safety defaults. Enable automation only after manual verification.
# Keep false until one manual nav-cycle --send succeeds. When true, the running service
# submits at most one guarded NAV settlement per UTC day.
ENABLE_AUTO_NAV=false
ENABLE_AUTO_RECONCILE=false
ENABLE_AUTO_CORE_WITHDRAW=false
ENABLE_AUTO_CONFIRM_CORE_DEPOSIT=false
ENABLE_AUTO_CONFIRM_CORE_WITHDRAWAL=false
MAX_NAV_CHANGE_BPS=2000
REDEEM_LIQUIDITY_BUFFER_BPS=100
DATABASE_URL=sqlite:///executor-testnet.db

# Optional gas override.
EXECUTOR_GAS_LIMIT=

# Optional external deleverage service integration.
TRADING_SERVICE_URL=http://localhost:9000
TRADING_SERVICE_API_KEY=
TRADING_SERVICE_DELEVERAGE_ENDPOINT=/deleverage
DELEVERAGE_REQUEST_TIMEOUT_SECONDS=3600

# Optional native /info read-only base URL; not /hypercore or /info.
HYPERCORE_INFO_URL=
